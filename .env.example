# Optional. When set, the humanizer rewrites with Claude; otherwise the built-in rule engine is used.
ANTHROPIC_API_KEY=

# Force an engine: "claude" or "local". Leave empty to auto-detect from ANTHROPIC_API_KEY.
PROSELY_ENGINE=

# Claude model and effort for rewrites (defaults: claude-opus-5, medium).
PROSELY_CLAUDE_MODEL=claude-opus-5
PROSELY_CLAUDE_EFFORT=medium

# Per-request word cap enforced by the API (default 500 = free plan; hard max 10000).
PROSELY_MAX_WORDS=500
